{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintPilot",
  "version": "0.9.5",
  "identifier": "ai.printpilot",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:17431",
    "beforeBuildCommand": "trunk build --cargo-profile release --no-sri",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PrintPilot",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost pp-asset: http://pp-asset.localhost https://pp-asset.localhost blob: data:; script-src 'self' 'wasm-unsafe-eval' 'strict-dynamic' 'unsafe-inline'; img-src 'self' pp-asset: http://pp-asset.localhost https://pp-asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "resources/cad-engine/": "cad-engine/"
    },
    "category": "Productivity",
    "shortDescription": "PrintPilot",
    "longDescription": "PrintPilot - 3D printing product workbench",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
